
menu
{
	name "B3AttackInfo_Menu_Ticker"
	ignoreesc

	label
	{
		opacity lua "B3AttackInfo_Private_Menu_Ticker_Tick()"
	}
}

menu
{
	name "B3AttackInfo_Menu"
	ignoreesc

	label
	{
		name "B3AttackInfo_Menu_BackgroundRect"
		area 0 0 -1 -1
	}

	text
	{
		name "B3AttackInfo_Menu_Icon"
		area -1 -1 -1 -1
		bam "B3ATKINF"
		frame lua "B3AttackInfo_Private_Menu_InfoList_BamFrame()"
		scaleToClip
	}

	label
	{
		name "B3AttackInfo_Menu_Label"
		area -1 -1 -1 -1
		text style "normal"
		text lua "B3AttackInfo_Private_Menu_Label"
		text color 255 255 255 255
	}

	label
	{
		name "B3AttackInfo_Menu_LabelSeparator"
		area -1 -1 -1 -1
		fill 112 111 111 64
	}

	label
	{
		name "B3AttackInfo_Menu_ImmuneColorKeyLabelSeparator"
		enabled "B3AttackInfo_Private_Menu_ShowImmuneColorKey"
		area -1 -1 -1 -1
		fill 112 111 111 64
	}

	label
	{
		name "B3AttackInfo_Menu_ImmuneColorKeyLabel"
		enabled "B3AttackInfo_Private_Menu_ShowImmuneColorKey"
		area -1 -1 -1 -1
		text style "normal"
		text "EEex_TRANSLATION_AttackInfo_ImmuneColorKey"
		text color 255 255 255 255
		text align left center
	}

	label
	{
		name "B3AttackInfo_Menu_ImmuneColorKey"
		enabled "B3AttackInfo_Private_Menu_ShowImmuneColorKey"
		area 0 0 -1 -1
		fill 255 75 43 255
	}

	list
	{
		-- Name column
		column
		{
			width -1

			label
			{
				area -1 0 -1 -1
				text style "normal"
				text lua "B3AttackInfo_Private_Menu_InfoList_Table[rowNumber][1]"
				text color 255 255 255 255
				text align right center
			}
		}

		-- Main hand column
		column
		{
			width -1

			label
			{
				area -1 0 -1 -1
				fill 112 111 111 64
			}

			label
			{
				area -1 0 -1 -1
				text style "normal"
				text lua "B3AttackInfo_Private_Menu_InfoList_Table[rowNumber][2]"
				text color 255 255 255 255
				text align right center
			}
		}

		-- Offhand column
		column
		{
			width -1

			label
			{
				area -1 0 -1 -1
				fill 112 111 111 64
			}

			label
			{
				area -1 0 -1 -1
				text style "normal"
				text lua "B3AttackInfo_Private_Menu_InfoList_Table[rowNumber][3]"
				text color 255 255 255 255
				text align right center
			}
		}

		-- End
		column
		{
			width -1

			label
			{
				area 0 -1 -1 -1
				fill 112 111 111 64
			}
		}

		area -1 -1 -1 -1
		name "B3AttackInfo_Menu_InfoList"
		table "B3AttackInfo_Private_Menu_InfoList_Table"
		var "B3AttackInfo_Private_Menu_InfoList_SelectedRow"
		rowheight -1
		hidehighlight
	}
}
